<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#66334155"
                android:endColor="#401E293B" />
            <stroke
                android:width="1dp"
                android:color="#6694A3B8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33334155"
                android:endColor="#1F1E293B" />
            <stroke
                android:width="1dp"
                android:color="#2E94A3B8" />
        </shape>
    </item>
</selector>
