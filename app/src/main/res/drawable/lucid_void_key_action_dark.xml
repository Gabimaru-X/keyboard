<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#66475569"
                android:endColor="#4D334155" />
            <stroke
                android:width="1dp"
                android:color="#66CBD5E1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3D334155"
                android:endColor="#261E293B" />
            <stroke
                android:width="1dp"
                android:color="#3894A3B8" />
        </shape>
    </item>
</selector>
